// Audit (read only): on a phone, can every window be closed by a tap beside it?
import { startServer, launch, openPage, waitReady } from "./helpers.mjs";
const server = await startServer(), browser = await launch();
const res = [];
async function fresh() {
  const page = await openPage(browser, `${server.url}/?e2e=1&base=off&nostats=1&lang=en#1960`, { width: 390, height: 844 });
  await waitReady(page);
  return page;
}
const vis = (page, sel) => page.evaluate((s) => { const e = document.querySelector(s); if (!e || e.hidden) return false; const r = e.getBoundingClientRect(); return r.width > 2 && r.height > 2 && getComputedStyle(e).display !== "none" && getComputedStyle(e).visibility !== "hidden"; }, sel);
async function tapOutside(page, x = 195, y = 420) { await page.mouse.click(x, y); await page.waitForTimeout(500); }

// 1. the window of details (info modal): the street card through the search
try {
  const p = await fresh();
  await p.click("#btnSearch"); await p.fill("#searchQ", "Kita Abashidze"); await p.locator("#searchRes li").filter({ hasText: "🛣" }).first().click();
  await p.waitForFunction(() => !document.getElementById("infoModal").hidden, null, { timeout: 15000 });
  await tapOutside(p, 5, 5);
  res.push(["info window (street card)", !(await vis(p, "#infoModal"))]);
  await p.ctx.close();
}

// 2. the viewer of the views
try {
  const p = await fresh();
  await p.click("#btnViews"); await p.check("#viewsAll"); await p.locator("#vgrid button").first().click();
  await p.waitForFunction(() => !document.getElementById("viewModal").hidden, null, { timeout: 5000 });
  await tapOutside(p, 5, 5);
  res.push(["viewer of the views", !(await vis(p, "#viewModal"))]);
  await p.ctx.close();
}

// 2b. the list window "Views" itself
try {
  const p = await fresh();
  await p.click("#btnViews");
  await p.waitForTimeout(500);
  const open = await vis(p, "#views");
  await tapOutside(p, 195, 700);
  res.push(["the panel Views (open before: " + open + ")", !(await vis(p, "#views"))]);
  await p.ctx.close();
}

// 3. the form "report a problem"
try {
  const p = await fresh();
  await p.click("#fbOpen").catch(async () => { await p.click("#btnInfo"); await p.click("#fbOpen"); });
  await p.waitForFunction(() => !document.getElementById("fbModal").hidden, null, { timeout: 5000 });
  await tapOutside(p, 5, 5);
  res.push(["form 'report a problem'", !(await vis(p, "#fbModal"))]);
  await p.ctx.close();
}

// 4. the panel of the filters
try {
  const p = await fresh();
  await p.click("#btnFilters"); await p.waitForTimeout(500);
  const open = await vis(p, "#filters");
  await tapOutside(p, 195, 30);
  res.push(["panel Filters (open before: " + open + ")", !(await vis(p, "#filters"))]);
  await p.ctx.close();
}

// 5. the panel Info (side)
try {
  const p = await fresh();
  if (!(await vis(p, "#side"))) await p.click("#btnInfo");
  await p.waitForTimeout(400);
  const open = await vis(p, "#side");
  await tapOutside(p, 195, 800);
  res.push(["panel Info (open before: " + open + ")", !(await vis(p, "#side"))]);
  await p.ctx.close();
}

// 6. the search window
try {
  const p = await fresh();
  await p.click("#btnSearch"); await p.waitForTimeout(400);
  const open = await vis(p, "#search");
  await tapOutside(p, 195, 800);
  res.push(["search window (open before: " + open + ")", !(await vis(p, "#search"))]);
  await p.ctx.close();
}

// 7. the menu "more"
try {
  const p = await fresh();
  const b = await vis(p, "#btnMore");
  if (b) { await p.click("#btnMore"); await p.waitForTimeout(400); }
  const open = await vis(p, "#more");
  await tapOutside(p, 195, 800);
  res.push(["menu more (button " + b + ", open before: " + open + ")", !(await vis(p, "#more"))]);
  await p.ctx.close();
}

// 8. a card on the map (popup): a tap on the map beside it closes it
try {
  const p = await fresh();
  await p.click("#btnSearch"); await p.fill("#searchQ", "Mushtaidi"); await p.locator("#searchRes li").first().click();
  await p.waitForSelector(".maplibregl-popup", { timeout: 15000 });
  await p.waitForTimeout(1500);
  const box = await p.locator(".maplibregl-popup").boundingBox();
  await tapOutside(p, 195, box.y > 300 ? 150 : 780);
  res.push(["card on the map (popup)", (await p.locator(".maplibregl-popup").count()) === 0]);
  await p.ctx.close();
}
for (const [n, ok] of res) console.log(ok ? "OK  " : "FAIL", n);
await browser.close(); server.srv.close();

