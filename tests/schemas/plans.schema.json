{
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "year", "title", "image", "corners", "overview"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "year": { "type": "integer" },
      "title": { "type": "string", "minLength": 1 },
      "source": { "type": "string" },
      "image": { "type": "string", "minLength": 1 },
      "overview": { "type": "string", "minLength": 1 },
      "corners": { "type": "array", "minItems": 4, "maxItems": 4 },
      "bounds": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
      "territory": { "type": "string", "minLength": 1 },
      "kind": { "type": "string", "enum": ["historical_map", "archaeological_plan", "schematic", "reconstruction"] },
      "depicted_from": { "type": "integer" },
      "depicted_to": { "type": "integer" },
      "survey_year": { "type": "integer" },
      "pub_year": { "type": "integer" },
      "accuracy_m": { "type": "integer" },
      "points": { "type": "integer" },
      "boundary": { "type": ["string", "null"] },
      "boundary_partial": { "type": "boolean" }
    }
  }
}
