{
  "$defs": {
    "lang3": {
      "type": "object",
      "required": ["ru", "en", "ka"],
      "properties": {
        "ru": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "ka": { "type": "string", "minLength": 1 }
      }
    },
    "lang3Opt": {
      "type": "object",
      "required": ["ru", "en", "ka"],
      "properties": {
        "ru": { "type": "string" },
        "en": { "type": "string" },
        "ka": { "type": "string" }
      }
    },
    "url3": {
      "type": "object",
      "required": ["ru", "en", "ka"],
      "properties": {
        "ru": { "type": "string", "pattern": "^https://" },
        "en": { "type": "string", "pattern": "^https://" },
        "ka": { "type": "string", "pattern": "^https://" }
      }
    },
    "srcList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^https?://" }
    }
  },
  "type": "object",
  "required": ["groups", "states", "rulers"],
  "properties": {
    "note": { "type": "string" },
    "groups": { "type": "object" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "kind", "lane", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "number" },
          "to": { "type": "number" },
          "kind": { "type": "string" },
          "lane": { "type": "integer" },
          "approx": { "type": "boolean" },
          "date": { "type": "string" },
          "name": { "$ref": "#/$defs/lang3" },
          "form": { "$ref": "#/$defs/lang3" },
          "note": { "$ref": "#/$defs/lang3Opt" },
          "src": { "$ref": "#/$defs/srcList" }
        }
      }
    },
    "rulers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "grp", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "number" },
          "to": { "type": "number" },
          "grp": { "type": "string" },
          "lane": { "type": "integer" },
          "date": { "type": "string" },
          "name": { "$ref": "#/$defs/lang3" },
          "title": { "$ref": "#/$defs/lang3" },
          "bio": { "$ref": "#/$defs/lang3" },
          "bio_src": { "$ref": "#/$defs/url3" },
          "note": { "$ref": "#/$defs/lang3Opt" },
          "src": { "$ref": "#/$defs/srcList" }
        }
      }
    }
  }
}
