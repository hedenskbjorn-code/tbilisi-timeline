#!/usr/bin/env sh
set -e

echo "[pre-push] Checking repository state and running fast data/unit checks..."

if ! git diff --quiet -- site tests || ! git diff --cached --quiet -- site tests; then
  echo "[pre-push] BLOCKED: uncommitted changes in site/ or tests/. Commit or clean them before pushing." >&2
  exit 1
fi

if ! python -P tools/build_all.py --stage; then
  echo "[pre-push] BLOCKED: build_all.py --stage failed (check curated_inputs.json LF hashes or derived files)." >&2
  exit 1
fi

if ! npm run test:data; then
  echo "[pre-push] BLOCKED: data/unit/DB checks failed. NEVER use --no-verify." >&2
  exit 1
fi

echo "[pre-push] OK: data, unit, manifest, and DB checks passed."
